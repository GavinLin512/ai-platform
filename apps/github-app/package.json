{
  "name": "@l10n-review/github-app",
  "version": "0.1.0",
  "private": true,
  "description": "The GitHub App: receives webhooks and posts reviews.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node src/index.ts",
    "review:dry-run": "node --env-file-if-exists=.env scripts/dry-run.ts",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@l10n-review/ai": "workspace:*",
    "@l10n-review/core": "workspace:*",
    "@l10n-review/db": "workspace:*",
    "hono": "^4.13.16",
    "octokit": "^5.0.5",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
