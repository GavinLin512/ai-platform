# GitHub App settings → "About" → App ID
GITHUB_APP_ID=123456

# Private key: point to the downloaded .pem (easiest locally; *.pem is gitignored)...
GITHUB_PRIVATE_KEY_PATH=./l10n-review-dev.private-key.pem
# ...or paste it inline (handy for CI secrets). Literal \n is turned into newlines.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# The "Webhook secret" you typed when creating the App
GITHUB_WEBHOOK_SECRET=change-me

PORT=3000

# Optional. With Postgres, reviews go through a durable queue and every run is recorded.
# Without it, reviews run in-process (fine for development). `docker compose up db` gives you one:
# DATABASE_URL=postgres://l10n:l10n@localhost:5432/l10n

# Optional. Enables the LLM checks (zh-tw-terminology, translation-meaning).
# Model and effort are set in .l10nrc.yml (ai.model, ai.effort); default claude-opus-5-5 / medium.
# ANTHROPIC_API_KEY=

# "pretty" for readable logs in a terminal; "json" (the default) in containers.
LOG_FORMAT=pretty

# Only for `pnpm review:dry-run`: any token that can read the target repository.
# GITHUB_TOKEN=
