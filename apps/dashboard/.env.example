# Postgres written by the GitHub App (the dashboard only reads it)
DATABASE_URL=postgres://l10n:l10n@localhost:5432/l10n

# Sign-in with GitHub (required in production; `pnpm dev` works without it).
# GitHub App settings → General → Client ID, and "Generate a new client secret".
# Add <dashboard URL>/api/auth/callback as a Callback URL in the same settings page.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# DASHBOARD_ALLOWED_USERS=your-github-login
# DASHBOARD_SESSION_SECRET=      # openssl rand -hex 32
