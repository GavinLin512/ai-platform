{
  "name": "l10n-review-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "AI localization reviewer for pull requests, focused on Asian languages.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @l10n-review/github-app dev",
    "review:dry-run": "pnpm --filter @l10n-review/github-app review:dry-run",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
