# GitHub App settings → "About" → App ID
GITHUB_APP_ID=123456

# Private key: point to the downloaded .pem (easiest locally; *.pem is gitignored)...
GITHUB_PRIVATE_KEY_PATH=./l10n-review-dev.private-key.pem
# ...or paste it inline (handy for CI secrets). Literal \n is turned into newlines.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# The "Webhook secret" you typed when creating the App
GITHUB_WEBHOOK_SECRET=change-me

PORT=3000

# Only for `pnpm review:dry-run`: any token that can read the target repository.
# GITHUB_TOKEN=
